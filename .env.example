# ─────────────────────────────────────────────────────────────
# Конфигурация Remnawave Node Auto-Installer
#
# Скопируйте этот файл на сервер, заполните значения и запустите:
#
#   sudo ./setup_remnawave_node.sh --config /opt/remnawave-installer/.env --non-interactive
#
# Путь по умолчанию: /opt/remnawave-installer/.env — если файл лежит
# там, флаг --config не нужен.
#
# ВАЖНО: файл содержит секреты. Сразу после создания выполните
#   chmod 600 /opt/remnawave-installer/.env
#
# Приоритет источников: переменная окружения → этот файл →
# значение по умолчанию → интерактивный вопрос.
# ─────────────────────────────────────────────────────────────


# ─── Обязательные параметры ───────────────────────────────────

# Роль ноды:
#   entry       — входная (РФ): nginx на 443 разводит подключения по
#                 SNI между Xray и сайтом-заглушкой. Открыто: 443/tcp, 80/tcp
#   exit        — выходная: трафик приходит с входных нод по NetBird,
#                 наружу ничего не открыто
#   exit-direct — выходная с прямыми подключениями и Hysteria2: 443
#                 слушает Xray. Открыто: 443/tcp, 443/udp, 8443/tcp, 80/tcp
NODE_ROLE="entry"

# Ключ из панели NetBird: https://app.netbird.io/ → Setup Keys.
# Для раскатки нескольких нод создайте reusable-ключ.
NETBIRD_SETUP_KEY=""

# Имя ноды в метриках. Должно быть УНИКАЛЬНЫМ для каждой ноды,
# иначе метрики разных серверов склеятся в одну серию.
INSTANCE_NAME="de-node-01"

# Адрес Victoria Metrics, куда vmagent шлёт метрики.
# Принимается и голый IP, и полный URL:
#   10.0.0.1                 → http://10.0.0.1:8428
#   http://10.0.0.1          → http://10.0.0.1:8428
#   https://vm.example.com:8428 → без изменений
VICTORIA_METRICS_URL="10.0.0.1"

# NetBird IP панели Remnawave — адрес панели ВНУТРИ mesh-сети,
# обычно из диапазона 100.64.0.0/10. НЕ публичный IP панели:
# панель ходит к ноде через NetBird, и правило UFW с публичным
# адресом просто не сработает.
# Найти: панель NetBird → Peers → строка сервера панели.
PANEL_NETBIRD_IP="100.64.0.1"


# ─── Необязательные параметры ─────────────────────────────────

# Порт, на котором нода слушает панель. Открывается в UFW только
# для PANEL_NETBIRD_IP.
NODE_PORT="2222"

# Тег образа remnawave/node — точная версия без "v", например 3.4.3.
# latest не принимается: ноды не должны разъезжаться по версиям.
# Список тегов: https://hub.docker.com/r/remnawave/node/tags
REMNANODE_VERSION="3.4.3"

# Порты SSH через пробел, например "22 2233".
# Если оставить пустым, порты определяются автоматически из
# sshd_config, sshd_config.d/*.conf, переменной $SSH_CONNECTION
# и списка слушающих сокетов.
#
# В неинтерактивном режиме подтвердить автоопределение некому,
# поэтому при раскатке на серверы с нестандартным SSH-портом
# лучше задать значение явно — ошибка стоит потери доступа.
SSH_PORTS=""

# Ключ ноды, который выдаёт панель Remnawave при её создании.
# Уникален для каждой ноды. Если оставить пустым, в
# docker-compose.yml будет записан плейсхолдер
# REPLACE_WITH_SECRET_KEY_FROM_PANEL — ключ можно вписать позже,
# после создания ноды в панели. При повторном запуске ключ из
# существующего /opt/remnanode/docker-compose.yml сохраняется.
SECRET_KEY=""


# ─── Роли entry и exit-direct ─────────────────────────────────
# Для роли exit этот раздел не нужен.

# Домен ноды. На entry по нему nginx отличает подключения к Xray
# от остальных; на обеих ролях — имя сайта-заглушки.
NODE_DOMAIN="ru03.example.org"

# Откуда берётся сертификат:
#   certwarden — CertWarden-клиент получает и продлевает его сам
#                (параметры CW_CLIENT_* ниже)
#   manual     — положите заранее в /opt/certs файлы fullchain.pem
#                (сертификат с цепочкой) и privkey.key (ключ).
#                Подходит wildcard-сертификат на домен
CERT_SOURCE="certwarden"

# Порт сайта-заглушки на 127.0.0.1. Снаружи не виден: на entry к
# нему ведёт nginx stream, на exit-direct — Xray (target для Reality).
SITE_LOCAL_PORT="9443"

# Только entry: порт Reality-инбаунда на 127.0.0.1, куда nginx
# передаёт подключения с SNI = NODE_DOMAIN. Должен совпадать с портом
# инбаунда в профиле entry-ru.
XRAY_LOCAL_PORT="10443"


# ─── CertWarden-клиент (CERT_SOURCE=certwarden) ───────────────
# Имена совпадают с переменными самого клиента и передаются ему
# как есть. Значения — в CertWarden: Certificates → <сертификат> →
# Post Processing → Cert Warden Client.

# Адрес сервера CertWarden, только https://
CW_CLIENT_SERVER_ADDRESS="https://certwarden.example.org"

# AES-ключ из Post Processing сертификата (секрет)
CW_CLIENT_AES_KEY_BASE64=""

# Имя сертификата и его API-ключ (секрет)
CW_CLIENT_CERT_NAME=""
CW_CLIENT_CERT_APIKEY=""

# Имя приватного ключа и его API-ключ (секрет)
CW_CLIENT_KEY_NAME=""
CW_CLIENT_KEY_APIKEY=""

# Окно, в которое клиент может заменить файлы и перезапустить nginx,
# и дни недели. Необязательно, значения по умолчанию — как на
# текущих серверах.
CW_CLIENT_FILE_UPDATE_TIME_START="02:00"
CW_CLIENT_FILE_UPDATE_TIME_END="03:00"
CW_CLIENT_FILE_UPDATE_DAYS_OF_WEEK="Mon Tue Wed Thu Fri Sat Sun"

# Часовой пояс для окна обновления
TZ="Europe/Moscow"
